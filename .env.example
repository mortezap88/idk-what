# HORMOUZ_API_KEY: Required for Hormouz AI gateway calls (GLM 5.3 Flash, GPT-6 Luna, Microsoft MAI-Transcribe 2).
# Users configure this securely via the Secrets panel in the AI Studio UI (or in-app Settings).
HORMOUZ_API_KEY=MY_HORMOUZ_API_KEY

# ONEXAI_API_KEY: Required for 1xAI Gemini STT and linguistic analysis calls.
# Users configure this securely via the Secrets panel in the AI Studio UI (or in-app Settings).
ONEXAI_API_KEY=MY_ONEXAI_API_KEY

# HOUSHYAR24_API_KEY: Required for Houshyar24 GPT 6 Luna tutoring and question generation calls.
# Users configure this securely via the Secrets panel in the AI Studio UI (or in-app Settings).
HOUSHYAR24_API_KEY=MY_HOUSHYAR24_API_KEY
